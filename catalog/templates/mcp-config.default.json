{
  "version": "1.0.0",
  "enabled": [
    "context7",
    "memory",
    "filesystem"
  ],
  "servers": {
    "context7": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@2.1.1"],
      "env": {}
    },
    "memory": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {}
    },
    "filesystem": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${YASWARM_WORKSPACE}"],
      "env": {}
    },
    "tremcp-ssh": {
      "enabled": false,
      "transport": "stdio",
      "command": "python3",
      "args": ["${YASWARM_WORKSPACE}/tremcp-ssh/tremcp_ssh/server.py"],
      "env": {
        "TREMCP_SSH_HOST": "${TREMCP_SSH_HOST}",
        "TREMCP_SSH_USER": "${TREMCP_SSH_USER}",
        "TREMCP_SSH_KEY_PATH": "${TREMCP_SSH_KEY_PATH}",
        "TREMCP_SSH_PASSWORD": "${TREMCP_SSH_PASSWORD}"
      }
    }
  }
}
