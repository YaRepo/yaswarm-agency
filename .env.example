# GitHub owner/org used by YaSwarm for generated project repos.
# Recommended: dedicated owner/org (example: yourname-yaswarm)
YASWARM_GITHUB_OWNER=
GITHUB_OWNER=
GITHUB_TOKEN=

# Workspace root for generated agency/project data.
YASWARM_WORKSPACE=

# Core API keys (leave empty until setup)
ZAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram tokens (optional during setup)
YASWARM_CEO_BOT_TOKEN=
YASWARM_TELEGRAM_RELAY_BOT_TOKEN=

# Optional MCP inspector ports
MCP_INSPECTOR_CLIENT_PORT=6274
MCP_INSPECTOR_SERVER_PORT=6277
