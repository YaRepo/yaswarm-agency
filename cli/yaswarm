#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
MCP_CONFIG="$ROOT/mcp/mcp-config.json"
SKILLS_REGISTRY="$ROOT/projects/yaswarm-skills-cataloge/catalog/skill-system/registry/skills-registry.json"
MCP_CATALOG="$ROOT/projects/yaswarm-mcps-cataloge/imports/agency/mcp-catalog.json"
WORKSPACE_DEFAULT="${YASWARM_WORKSPACE:-$ROOT/projects/yaswarm-desk-workspace}"

help() {
  cat << 'HELP'
YaSwarm CLI

Usage:
  yaswarm help
  yaswarm init --github-owner <owner> [--private|--public] [--new-workspace <path>] [--force-clean]
  yaswarm reconfigure --github-owner <owner> [--workspace <path>] [--private|--public] [--dry-run] [--skip-pull] [--no-create-missing]
  yaswarm upgrade [--workspace <path>] [--dry-run]
  yaswarm doctor [workspace_path]
  yaswarm onboard
  yaswarm chat [--message "text"]

  yaswarm skill list

  yaswarm mcp list
  yaswarm mcp inspect [server-command...]
  yaswarm mcp health
  yaswarm pi status [--workspace <path>]
  yaswarm pi verify [--workspace <path>]
  yaswarm pi verify-runtime [--workspace <path>]
  yaswarm pi setup [--command <binary>] [--llm <id>] [--vlm <id>] [--tts <id>] [--workspace <path>]

  yaswarm repo init
  yaswarm repo create-new <project_name> [private|public]
  yaswarm repo link-existing <project_name> <repo_url>
  yaswarm repo sync <project_name>
  yaswarm repo sync-all
  yaswarm repo list

  yaswarm sync start [interval_sec]
  yaswarm sync stop
  yaswarm sync status
  yaswarm sync run-once
  yaswarm sync run-forever [interval_sec]

  yaswarm swarm init
  yaswarm swarm status
  yaswarm swarm dispatch <department> <title>
  yaswarm swarm complete <task_id>

  yaswarm bots list
  yaswarm bots reconcile
  yaswarm telegram bridge-once
  yaswarm telegram bridge-loop [interval_sec]
  yaswarm register

  yaswarm dashboard refresh

  yaswarm agency status
  yaswarm agency backend-capabilities <backend>
  yaswarm agency department-update <departmentId> [--backend <name>] [--model <id>] [--modelTier <tier>] [--providerIds <csv>] [--fallbackModels <csv>] [--backendUrl <url>] [--autoInstallBackend]
  yaswarm agency governor-status
  yaswarm agency governor-set [--enabled true|false] [--autoDelay true|false]
  yaswarm agency permissions-get
  yaswarm agency permissions-set [--subagentHead true|false] [--headCeo true|false] [--ceoUser true|false] [--allowSubagentFull true|false]
  yaswarm agency approvals-list
  yaswarm agency approval-approve <approvalId> [--note "..."] [--approvedCommand "..."]
  yaswarm agency approval-reject <approvalId> [--note "..."]
  yaswarm agency terminal-exec <sessionId> <command> [--taskName <name>] [--taskWeight light|medium|heavy] [--actorRole subagent|head|ceo|user] [--requestedAccess default|full] [--approvalId <id>] [--force]
  yaswarm agency skills-list
  yaswarm agency skills-routing
  yaswarm agency skill-get <name>
  yaswarm agency mcp-servers
  yaswarm agency mcp-tools
  yaswarm agency mcp-registry
  yaswarm agency mcp-config
  yaswarm agency mcp-env-list
  yaswarm agency mcp-env-set <KEY> <VALUE>
HELP
}

cmd="${1:-help}"
sub="${2:-}"

case "$cmd" in
  help|-h|--help)
    help
    ;;
  init)
    shift || true
    "$ROOT/scripts/init.sh" "$@"
    ;;
  reconfigure)
    shift || true
    "$ROOT/scripts/reconfigure.sh" "$@"
    ;;
  upgrade)
    shift || true
    "$ROOT/scripts/migrate-configs.sh" "$@"
    ;;
  doctor)
    shift || true
    "$ROOT/scripts/doctor.sh" "$@"
    ;;
  onboard)
    "$ROOT/scripts/onboarding.sh"
    "$ROOT/scripts/sync-agency-config.sh" >/dev/null 2>&1 || true
    "$ROOT/scripts/bots-manage.sh" reconcile >/dev/null 2>&1 || true
    ;;
  chat)
    shift || true
    python3 "$ROOT/scripts/chat-cli.py" "$@"
    ;;
  skill)
    [[ "$sub" == "list" ]] || { echo "Unknown skill subcommand: $sub" >&2; exit 1; }
    if [[ -f "$SKILLS_REGISTRY" ]]; then
      cat "$SKILLS_REGISTRY"
    else
      ls -1 "$ROOT/skills" 2>/dev/null || echo "No local skills imported yet"
    fi
    ;;
  mcp)
    case "$sub" in
      list)
        if [[ -f "$MCP_CONFIG" ]]; then
          cat "$MCP_CONFIG"
        elif [[ -f "$MCP_CATALOG" ]]; then
          cat "$MCP_CATALOG"
        else
          cat "$ROOT/mcp/mcp-config.example.json"
        fi
        ;;
      inspect)
        shift 2 || true
        if [[ "$#" -eq 0 ]]; then
          CLIENT_PORT="${MCP_INSPECTOR_CLIENT_PORT:-6274}" SERVER_PORT="${MCP_INSPECTOR_SERVER_PORT:-6277}" npx @modelcontextprotocol/inspector
        else
          CLIENT_PORT="${MCP_INSPECTOR_CLIENT_PORT:-6274}" SERVER_PORT="${MCP_INSPECTOR_SERVER_PORT:-6277}" npx @modelcontextprotocol/inspector "$@"
        fi
        ;;
      health)
        "$ROOT/scripts/mcp-health.sh"
        ;;
      *)
        echo "Unknown mcp subcommand: $sub" >&2; exit 1
        ;;
    esac
    ;;
  pi)
    case "$sub" in
      status|verify|verify-runtime|setup)
        shift 2 || true
        "$ROOT/scripts/pi-mono.sh" "$sub" "$@"
        ;;
      *)
        echo "Unknown pi subcommand: $sub" >&2; exit 1
        ;;
    esac
    ;;
  repo)
    case "$sub" in
      init)
        "$ROOT/scripts/repo-catalog-init.sh"
        ;;
      create-new|link-existing|sync|sync-all|list)
        shift 2 || true
        "$ROOT/scripts/repo-catalog.sh" "$sub" "$@"
        ;;
      *)
        echo "Unknown repo subcommand: $sub" >&2; exit 1
        ;;
    esac
    ;;
  swarm)
    case "$sub" in
      init)
        "$ROOT/scripts/pi-mono.sh" verify-runtime --workspace "$WORKSPACE_DEFAULT"
        python3 "$ROOT/swarm/runtime.py" "$sub"
        "$ROOT/scripts/sync-agency-config.sh" >/dev/null 2>&1 || true
        "$ROOT/scripts/bots-manage.sh" reconcile >/dev/null 2>&1 || true
        ;;
      status)
        python3 "$ROOT/swarm/runtime.py" "$sub"
        ;;
      dispatch|complete)
        shift 2 || true
        python3 "$ROOT/swarm/runtime.py" "$sub" "$@"
        ;;
      *)
        echo "Unknown swarm subcommand: $sub" >&2; exit 1
        ;;
    esac
    ;;
  bots)
    case "$sub" in
      list|reconcile)
        "$ROOT/scripts/bots-manage.sh" "$sub"
        ;;
      *)
        echo "Unknown bots subcommand: $sub" >&2; exit 1
        ;;
    esac
    ;;
  telegram)
    case "$sub" in
      bridge-once)
        python3 "$ROOT/scripts/telegram-bridge-worker.py" run-once
        ;;
      bridge-loop)
        shift 2 || true
        iv="${1:-3}"
        python3 "$ROOT/scripts/telegram-bridge-worker.py" run-forever --interval "$iv"
        ;;
      *)
        echo "Unknown telegram subcommand: $sub" >&2; exit 1
        ;;
    esac
    ;;
  register)
    "$ROOT/scripts/pi-mono.sh" verify-runtime --workspace "$WORKSPACE_DEFAULT"
    "$ROOT/scripts/sync-agency-config.sh"
    "$ROOT/scripts/bots-manage.sh" reconcile
    python3 "$ROOT/scripts/dashboard-bridge.py" >/dev/null 2>&1 || true
    echo "YaSwarm registration complete"
    ;;
  sync)
    case "$sub" in
      start|stop|status|run-once|run-forever)
        shift 2 || true
        "$ROOT/scripts/auto-sync.sh" "$sub" "$@"
        ;;
      *)
        echo "Unknown sync subcommand: $sub" >&2; exit 1
        ;;
    esac
    ;;
  dashboard)
    [[ "$sub" == "refresh" ]] || { echo "Unknown dashboard subcommand: $sub" >&2; exit 1; }
    python3 "$ROOT/scripts/dashboard-bridge.py"
    ;;
  agency)
    shift || true
    if [[ "$#" -eq 0 ]]; then
      echo "Usage: yaswarm agency <subcommand> [args...]" >&2
      exit 1
    fi
    python3 "$ROOT/scripts/agency-api.py" "$@"
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    help
    exit 1
    ;;
esac
