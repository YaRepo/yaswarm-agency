#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
MCP_CONFIG="$ROOT/mcp/mcp-config.json"

help() {
  cat << 'HELP'
YaMind Swarm CLI

Usage:
  yaswarm help
  yaswarm onboard

  yaswarm skill list

  yaswarm mcp list
  yaswarm mcp inspect [server-command...]
  yaswarm mcp health

  yaswarm repo init
  yaswarm repo create-new <project_name> [private|public]
  yaswarm repo link-existing <project_name> <repo_url>
  yaswarm repo sync <project_name>
  yaswarm repo sync-all
  yaswarm repo list

  yaswarm sync start [interval_sec]
  yaswarm sync stop
  yaswarm sync status
  yaswarm sync run-once

  yaswarm swarm init
  yaswarm swarm status
  yaswarm swarm dispatch <department> <title>
  yaswarm swarm complete <task_id>

  yaswarm dashboard refresh
HELP
}

cmd="${1:-help}"
sub="${2:-}"

case "$cmd" in
  help|-h|--help)
    help
    ;;
  onboard)
    "$ROOT/scripts/onboarding.sh"
    ;;
  skill)
    [[ "$sub" == "list" ]] || { echo "Unknown skill subcommand: $sub" >&2; exit 1; }
    ls -1 "$ROOT/skills" 2>/dev/null || echo "No local skills imported yet"
    ;;
  mcp)
    case "$sub" in
      list)
        if [[ -f "$MCP_CONFIG" ]]; then cat "$MCP_CONFIG"; else cat "$ROOT/mcp/mcp-config.example.json"; fi
        ;;
      inspect)
        shift 2 || true
        if [[ "$#" -eq 0 ]]; then
          CLIENT_PORT="${MCP_INSPECTOR_CLIENT_PORT:-6274}" SERVER_PORT="${MCP_INSPECTOR_SERVER_PORT:-6277}" npx @modelcontextprotocol/inspector
        else
          CLIENT_PORT="${MCP_INSPECTOR_CLIENT_PORT:-6274}" SERVER_PORT="${MCP_INSPECTOR_SERVER_PORT:-6277}" npx @modelcontextprotocol/inspector "$@"
        fi
        ;;
      health)
        "$ROOT/scripts/mcp-health.sh"
        ;;
      *)
        echo "Unknown mcp subcommand: $sub" >&2; exit 1
        ;;
    esac
    ;;
  repo)
    case "$sub" in
      init)
        "$ROOT/scripts/repo-catalog-init.sh"
        ;;
      create-new|link-existing|sync|sync-all|list)
        shift 2 || true
        "$ROOT/scripts/repo-catalog.sh" "$sub" "$@"
        ;;
      *)
        echo "Unknown repo subcommand: $sub" >&2; exit 1
        ;;
    esac
    ;;
  swarm)
    case "$sub" in
      init|status)
        python3 "$ROOT/swarm/runtime.py" "$sub"
        ;;
      dispatch|complete)
        shift 2 || true
        python3 "$ROOT/swarm/runtime.py" "$sub" "$@"
        ;;
      *)
        echo "Unknown swarm subcommand: $sub" >&2; exit 1
        ;;
    esac
    ;;
  sync)
    case "$sub" in
      start|stop|status|run-once)
        shift 2 || true
        "$ROOT/scripts/auto-sync.sh" "$sub" "$@"
        ;;
      *)
        echo "Unknown sync subcommand: $sub" >&2; exit 1
        ;;
    esac
    ;;
  dashboard)
    [[ "$sub" == "refresh" ]] || { echo "Unknown dashboard subcommand: $sub" >&2; exit 1; }
    python3 "$ROOT/scripts/dashboard-bridge.py"
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    help
    exit 1
    ;;
esac
